# ==========================================
# SYSTEM ZARZĄDZANIA BIBLIOTEKĄ - Zmienne Środowiskowe
# ==========================================
# BAZA DANYCH - PostgreSQL
# ==========================================
# Dane dostępowe do bazy danych PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=biblioteka
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Pełny connection string (używany przez wszystkie serwisy)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ==========================================
# JWT - Tokeny Autoryzacyjne (Wymaganie NF4)
# ==========================================
# WAŻNE: W produkcji MUSIMY zmienić SECRET_KEY!
# Komenda: openssl rand -hex 32
SECRET_KEY=super-tajny-klucz-jwt-change-in-production-minimum-32-znaki-losowe-abc123xyz789

# Algorytm szyfrowania tokenów
ALGORITHM=HS256

# Czas ważności access token (w minutach) - Wymaganie NF4
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Czas ważności refresh token (w dniach) - Wymaganie NF4
REFRESH_TOKEN_EXPIRE_DAYS=14

# ==========================================
# ŚRODOWISKO
# ==========================================
# Typ środowiska: development (deweloperskie) | staging (testowe) | production (produkcyjne)
ENVIRONMENT=development

# ==========================================
# LOGOWANIE (Wymaganie NF16)
# ==========================================
# Poziom szczegółowości logów
# Opcje: DEBUG (najwięcej info) | INFO | WARNING | ERROR | CRITICAL (tylko błędy krytyczne)
LOG_LEVEL=INFO

# ==========================================
# CORS - Cross-Origin Resource Sharing (Wymaganie NF6)
# ==========================================
# Adresy URL frontendów które mogą się łączyć z API (rozdzielone przecinkami)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ==========================================
# RATE LIMITING - Ograniczanie Liczby Zapytań (Wymaganie NF21)
# ==========================================
# Czy włączyć rate limiting
RATE_LIMIT_ENABLED=true

# Maksymalna liczba zapytań na minutę (globalnie) - Wymaganie NF21
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Maksymalna liczba prób logowania na minutę - Wymaganie NF21
RATE_LIMIT_LOGIN_REQUESTS_PER_MINUTE=5

# ==========================================
# REGUŁY BIZNESOWE - Ustawienia Systemu Biblioteki (Wymaganie F29)
# ==========================================

# --- REZERWACJE ---
# Czas trwania rezerwacji w dniach (po tym czasie rezerwacja wygasa) - Wymaganie F8
RESERVATION_DURATION_DAYS=3

# Maksymalna liczba aktywnych rezerwacji na użytkownika - Wymaganie F8
MAX_RESERVATIONS_PER_USER=3

# --- WYPOŻYCZENIA ---
# Czas trwania wypożyczenia w dniach - Wymaganie F11
LOAN_DURATION_DAYS=14

# Maksymalna liczba aktywnych wypożyczeń na użytkownika - Wymaganie F11
MAX_LOANS_PER_USER=5

# Czy można przedłużać wypożyczenia - Wymaganie F14
ALLOW_LOAN_EXTENSION=true

# --- KARY (Wymaganie NF29) ---
# Wysokość kary za jeden dzień przetrzymania (w PLN) - Wymaganie NF29
FINE_PER_DAY=1.00

# Maksymalna wysokość kary (w PLN) - Wymaganie NF29
MAX_FINE_AMOUNT=100.00

# ==========================================
# PORTY SERWISÓW
# ==========================================
# Port dla serwisu autoryzacji (Auth Service)
AUTH_SERVICE_PORT=8001

# Port dla serwisu katalogu (Catalog Service)
CATALOG_SERVICE_PORT=8002

# Port dla serwisu wypożyczeń (Loan Service)
LOAN_SERVICE_PORT=8003

# Port dla aplikacji frontendowej (React)
FRONTEND_PORT=3000

# ==========================================
# REDIS (OPCJONALNIE - dla refresh tokens w pamięci)
# ==========================================
# Host Redis
REDIS_HOST=redis

# Port Redis
REDIS_PORT=6379

# Hasło Redis (puste jeśli brak)
REDIS_PASSWORD=

# Numer bazy danych Redis (0-15)
REDIS_DB=0

# ==========================================
# EMAIL (OPCJONALNIE - dla powiadomień, Wymaganie F21)
# ==========================================
# Serwer SMTP
SMTP_HOST=smtp.gmail.com

# Port SMTP
SMTP_PORT=587

# Email nadawcy
SMTP_USER=your-email@gmail.com

# Hasło aplikacji (nie zwykłe hasło!)
SMTP_PASSWORD=your-app-password

# Email "Od kogo" w wiadomościach
SMTP_FROM=noreply@biblioteca.pl

# ==========================================
# SENTRY (OPCJONALNIE - monitoring błędów w produkcji)
# ==========================================
# DSN (Data Source Name) z Sentry.io
SENTRY_DSN=

# ==========================================
# TESTOWANIE
# ==========================================
# Connection string do testowej bazy danych (osobna od głównej)
TEST_DATABASE_URL=postgresql://admin:admin123@localhost:5432/biblioteka_test
