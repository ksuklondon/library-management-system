# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.py text
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.md text
*.yaml text
*.yml text
*.txt text
*.sh text
*.bat text eol=crlf

# Declare files that will always have CRLF line endings on checkout
*.bat eol=crlf
*.cmd eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
