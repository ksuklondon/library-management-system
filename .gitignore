# ============================================
# NODE.JS / REACT / FRONTEND
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Build outputs
dist/
dist-ssr/
build/
*.local

# ============================================
# ENVIRONMENT VARIABLES - CRITICAL!
# ============================================
# UWAGA: Pliki .env zawierają sekrety (SECRET_KEY, hasła DB, itp.)
# NIE COMMITUJ ich do repozytorium!

# Ignoruj wszystkie pliki .env
*.env

# Ignoruj .env w mikrousługach
backend/**/.env
backend/*/.env
backend/auth-service/.env
backend/catalog-service/.env
backend/loan-service/.env

# Ignoruj .env w frontendzie
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# WYJĄTEK: Pliki .env.example MOŻNA commitować (to szablony)
!*.env.example
!backend/**/.env.example
!backend/*/.env.example

# ============================================
# IDE / EDITORS
# ============================================
.vscode/launch.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ============================================
