# Przykładowy plik konfiguracyjny dla Auth Service.
# Ten plik NIE powinien zawierać prawdziwych haseł/sekretów w repozytorium.
# Użytkownik powinien skopiować go do .env i uzupełnić własnymi wartościami.

# Adres połączenia z bazą PostgreSQL (używany przez SQLAlchemy).
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://admin:admin123@postgres:5432/biblioteka

# Klucz używany do podpisywania tokenów JWT.
# W środowisku produkcyjnym MUSI być długi, losowy i tajny (min. 32 znaki).
SECRET_KEY=super-secret-key-change-in-production-min-32-chars

# Algorytm używany do podpisu JWT (np. HS256).
ALGORITHM=HS256

# Czas ważności access tokenu w minutach.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Nazwa serwisu (pomocne przy logowaniu / monitoringu).
SERVICE_NAME=auth-service

# Port, na którym nasłuchuje Auth Service wewnątrz kontenera.
PORT=8001

# Aktualne środowisko:
# - development
# - staging
# - production
ENVIRONMENT=development

# Poziom logowania:
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Dozwolone originy CORS – adresy frontendów, które mogą wywoływać API.
# Wartości rozdzielone przecinkami.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

