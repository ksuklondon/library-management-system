# ==========================================
# CATALOG SERVICE - Zmienne środowiskowe
# ==========================================
# Skopiuj jako .env: cp .env.example .env

# ==========================================
# BAZA DANYCH
# ==========================================
DATABASE_URL=postgresql://admin:admin123@postgres:5432/biblioteka

# ==========================================
# JWT (do weryfikacji tokenów z auth-service)
# ==========================================
SECRET_KEY=super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256

# ==========================================
# APLIKACJA
# ==========================================
SERVICE_NAME=catalog-service
PORT=8002
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==========================================
# CORS
# ==========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================
# URLS INNYCH SERWISÓW
# ==========================================
AUTH_SERVICE_URL=http://auth-service:8001
