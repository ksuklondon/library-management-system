# Adres połączenia z bazą danych PostgreSQL (użytkownik, hasło, host, port, nazwa bazy)
DATABASE_URL=postgresql://admin:admin123@postgres:5432/biblioteka

# Nazwa mikroserwisu – pomocne w logach i monitoringu
SERVICE_NAME=loan-service

# Port, na którym działa loan-service wewnątrz kontenera
PORT=8003

# Środowisko uruchomieniowe: development / production / staging
ENVIRONMENT=development

# Poziom logowania (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Adres URL do komunikacji z auth-service (np. weryfikacja tokenów)
AUTH_SERVICE_URL=http://auth-service:8001

# Adres URL do komunikacji z catalog-service (np. walidacja dostępności książek)
CATALOG_SERVICE_URL=http://catalog-service:8002

# Maksymalna liczba jednoczesnych rezerwacji dla jednego użytkownika
MAX_RESERVATIONS_PER_USER=3

# Maksymalna liczba aktywnych wypożyczeń dla jednego użytkownika
MAX_LOANS_PER_USER=5

# Domyślny czas wypożyczenia książki (w dniach)
LOAN_DURATION_DAYS=14

# Po ilu dniach wygasa rezerwacja, jeśli użytkownik jej nie wykorzysta
RESERVATION_EXPIRY_DAYS=3

# Opłata naliczana za każdy dzień spóźnienia (kara)
FINE_PER_DAY=2.00

# Dozwolone domeny dla CORS (frontend)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
